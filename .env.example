# ─── AI-SupportPilot Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values before running.

# ── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=/api
BACKEND_URL=http://localhost:5050
PORT=5050

# ── Java API ─────────────────────────────────────────────────────────────────
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supportpilot
DB_USER=postgres
DB_PASSWORD=postgres

# JWT secret — CHANGE IN PRODUCTION
JWT_SECRET=AI-SupportPilot-Change-This-In-Production-Secret
JWT_EXPIRATION_MS=86400000

# Python AI service URL
PYTHON_API_URL=http://localhost:8000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Set MAIL_ENABLED=true and fill in your SMTP provider details to send real emails.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional shared key between frontend and backend (recommended in production).
# When set, the frontend must send VITE_EMAIL_API_KEY matching EMAIL_API_KEY.
EMAIL_API_KEY=
VITE_EMAIL_API_KEY=

# ── JIRA Integration ───────────────────────────────────────────────────────────
# Set JIRA_ENABLED=true and fill these in to sync tickets to a JIRA Cloud project.
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Leaving JIRA_ENABLED=false (default) disables the integration entirely — ticket
# creation works normally either way, JIRA sync just gets skipped.
# ── JIRA Integration ───────────────────────────────────────────────────────────
JIRA_ENABLED=true
JIRA_BASE_URL=https://swathigundlapuri4.atlassian.net
JIRA_EMAIL=swathigundlapuri4@gmail.com
JIRA_API_TOKEN=ATATT3xFfGF0wDcPKqU69DHZaLsBfeGEVyFChPLiX127F2SfqfYMWTnkEqDgmavzXbQpvjRc76CS3jrTEZ9RqVEDpZa0xvmK1ut8htq329lmyCW4aPHe1G3ZrYU-4wzhEHBdaEhWxebrnDgzKenAaCL-6Sb1jmPaIB-SKN6als4bl6HBnzYI4WA=0B00EB14
JIRA_PROJECT_KEY=AS
JIRA_ISSUE_TYPE=Task

# ── Demo / seeded accounts ─────────────────────────────────────────────────────
# Overrides the single shared password used for all seeded demo accounts
# (admin@supportpilot.ai, support@supportpilot.ai, employee@supportpilot.ai).
# See backend/java-api/.../config/DataSeeder.java for details — these are
# testing-convenience accounts, not meant for production use.
DEMO_PASSWORD=SupportPilot@2025

# ── Python AI Service ─────────────────────────────────────────────────────────
# PORT=8000
# LOG_LEVEL=INFO
# OPENAI_API_KEY=sk-...    # Optional — only needed for LLM-based summarization
